<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Aluno" name="Aluno" processRef="Process_Aluno" />
    <bpmn:participant id="Participant_Escola" name="Escola de idiomas" processRef="Process_Escola" />
    <bpmn:messageFlow id="MF_Pedido" name="Pedido de reposição" sourceRef="Task_Solicitar" targetRef="Start_Esc" />
    <bpmn:messageFlow id="MF_Recusa" name="Recusa" sourceRef="Task_Recusa" targetRef="Task_Receber" />
    <bpmn:messageFlow id="MF_Confirma" name="Confirmação" sourceRef="Task_Confirmar" targetRef="Task_Receber" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Aluno" isExecutable="false">
    <bpmn:startEvent id="Start_Aluno" name="Aluno faltou">
      <bpmn:outgoing>SF_A1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Solicitar" name="Solicitar reposição">
      <bpmn:incoming>SF_A1</bpmn:incoming>
      <bpmn:outgoing>SF_A2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Receber" name="Receber resposta da escola">
      <bpmn:incoming>SF_A2</bpmn:incoming>
      <bpmn:outgoing>SF_A3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Aluno" name="Aluno informado">
      <bpmn:incoming>SF_A3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_A1" sourceRef="Start_Aluno" targetRef="Task_Solicitar" />
    <bpmn:sequenceFlow id="SF_A2" name="Aguarda resposta" sourceRef="Task_Solicitar" targetRef="Task_Receber" />
    <bpmn:sequenceFlow id="SF_A3" sourceRef="Task_Receber" targetRef="End_Aluno" />
  </bpmn:process>
  <bpmn:process id="Process_Escola" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Escola">
      <bpmn:lane id="Lane_Secretaria" name="Secretaria">
        <bpmn:flowNodeRef>Start_Esc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Consultar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Vaga</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reservar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Recusa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Recusa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Confirmar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Agendada</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Professor" name="Professor">
        <bpmn:flowNodeRef>Task_Incluir</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Esc" name="Pedido recebido">
      <bpmn:outgoing>SF_E1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Pedido" />
    </bpmn:startEvent>
    <bpmn:task id="Task_Consultar" name="Consultar vagas em outros horários">
      <bpmn:incoming>SF_E1</bpmn:incoming>
      <bpmn:outgoing>SF_E2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Vaga" name="Há vaga?">
      <bpmn:incoming>SF_E2</bpmn:incoming>
      <bpmn:outgoing>SF_E3</bpmn:outgoing>
      <bpmn:outgoing>SF_E4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Reservar" name="Reservar vaga na turma">
      <bpmn:incoming>SF_E3</bpmn:incoming>
      <bpmn:outgoing>SF_E6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Recusa" name="Informar recusa ao aluno">
      <bpmn:incoming>SF_E4</bpmn:incoming>
      <bpmn:outgoing>SF_E5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Recusa" name="Reposição recusada">
      <bpmn:incoming>SF_E5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="GW_Split">
      <bpmn:incoming>SF_E6</bpmn:incoming>
      <bpmn:outgoing>SF_E7</bpmn:outgoing>
      <bpmn:outgoing>SF_E8</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_Confirmar" name="Confirmar reposição ao aluno">
      <bpmn:incoming>SF_E7</bpmn:incoming>
      <bpmn:outgoing>SF_E9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Incluir" name="Incluir aluno na lista da turma">
      <bpmn:incoming>SF_E8</bpmn:incoming>
      <bpmn:outgoing>SF_E10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="GW_Join">
      <bpmn:incoming>SF_E9</bpmn:incoming>
      <bpmn:incoming>SF_E10</bpmn:incoming>
      <bpmn:outgoing>SF_E11</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="End_Agendada" name="Reposição agendada">
      <bpmn:incoming>SF_E11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_E1" sourceRef="Start_Esc" targetRef="Task_Consultar" />
    <bpmn:sequenceFlow id="SF_E2" sourceRef="Task_Consultar" targetRef="GW_Vaga" />
    <bpmn:sequenceFlow id="SF_E3" name="Sim" sourceRef="GW_Vaga" targetRef="Task_Reservar" />
    <bpmn:sequenceFlow id="SF_E4" name="Não" sourceRef="GW_Vaga" targetRef="Task_Recusa" />
    <bpmn:sequenceFlow id="SF_E5" sourceRef="Task_Recusa" targetRef="End_Recusa" />
    <bpmn:sequenceFlow id="SF_E6" sourceRef="Task_Reservar" targetRef="GW_Split" />
    <bpmn:sequenceFlow id="SF_E7" sourceRef="GW_Split" targetRef="Task_Confirmar" />
    <bpmn:sequenceFlow id="SF_E8" sourceRef="GW_Split" targetRef="Task_Incluir" />
    <bpmn:sequenceFlow id="SF_E9" sourceRef="Task_Confirmar" targetRef="GW_Join" />
    <bpmn:sequenceFlow id="SF_E10" sourceRef="Task_Incluir" targetRef="GW_Join" />
    <bpmn:sequenceFlow id="SF_E11" sourceRef="GW_Join" targetRef="End_Agendada" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
